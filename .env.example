NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Optional, dev only: LAN hosts allowed to load the dev server (comma-separated).
# Supabase rejects raw-IP redirect URLs, so sign in from a phone via <ip>.nip.io.
DEV_ORIGINS=192.168.1.6,192.168.1.6.nip.io
